{
  "expo": {
    "name": "Buko",
    "slug": "buko",
    "scheme": "buko",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "baseUrl": "/buko"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Buko uses the camera to scan product barcodes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-dev-client",
      "./plugins/withStoreBilling",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Buko reads your steps, active calories and workouts from Apple Health, only if you turn that on, to adjust your daily calorie target and show your activity. This data is never used for advertising or shared with anyone else.",
          "NSHealthUpdateUsageDescription": "Buko saves the workouts and nutrition you log to Apple Health, only if you turn that on, so your health records stay complete. This data is never used for advertising or shared with anyone else."
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      "expo-sharing",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.cmgwynn.buko.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.cmgwynn.buko",
          "enablePushNotifications": false,
          "frequentUpdates": false,
          "widgets": []
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/buko_rest_cue.wav"
          ]
        }
      ],
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cmgwynn.buko",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E5F1E9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.cmgwynn.buko",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.WRITE_NUTRITION"
      ]
    }
  }
}
