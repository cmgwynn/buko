EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Free key: https://fdc.nal.usda.gov/api-key-signup
EXPO_PUBLIC_USDA_API_KEY=your-usda-api-key
# Included in the User-Agent sent to Open Food Facts (their API terms require a way to contact the app owner)
EXPO_PUBLIC_CONTACT_EMAIL=you@example.com
# Store SDK public keys only, never the RevenueCat secret API key.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Leave false for the existing unrestricted web preview. Enable only with server rollout + verified billing.
EXPO_PUBLIC_PREMIUM_ENFORCEMENT=false
# Publish your own documents before enabling purchases or submitting to stores.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
